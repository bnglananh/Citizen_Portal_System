{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Chrome Debug",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "Backend: Spring Boot App",
      "type": "java",
      "request": "launch",
      "mainClass": "com.citizenportal.backend.BackendApplication",
      "projectName": "backend",
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}
